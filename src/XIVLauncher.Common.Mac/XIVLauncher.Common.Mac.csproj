<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Product>XIVLauncher.Common.Mac</Product>
        <AssemblyTitle>XIVLauncher.Common.Mac</AssemblyTitle>
        <Description>macOS platform-specific implementations for XIVLauncherCN (Wine launcher, Dalamud bootstrap, paths).</Description>
        <VersionPrefix>1.0.0</VersionPrefix>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\XIVLauncher.Common\XIVLauncher.Common.csproj"/>
        <ProjectReference Include="..\XIVLauncher.Login\XIVLauncher.Login.csproj"/>
        <ProjectReference Include="..\XIVLauncher.Dalamud.Mac\XIVLauncher.Dalamud.Mac.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json"/>
        <PackageReference Include="Serilog"/>
    </ItemGroup>
</Project>
