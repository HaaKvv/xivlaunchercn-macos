<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XIVLauncher.Views.SettingsWindow"
        Title="设置 · XIVLauncherCN"
        Width="660" Height="640"
        MinWidth="560" MinHeight="480"
        Background="{DynamicResource PanelBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="18">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,14,0,0">
            <TextBlock x:Name="SaveError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="取消" Click="OnCancelClick" IsCancel="True" />
                <Button Content="保存" Click="OnSaveClick" IsDefault="True" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
                <TextBlock Text="常规" Classes="section" />

                <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="8" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏目录" Classes="label" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GamePath}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Click="OnBrowseGamePath" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="补丁缓存" Classes="label" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PatchPath}" />
                    <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Click="OnBrowsePatchPath" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="启动参数" Classes="label" />
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AdditionalLaunchArgs}"
                             PlaceholderText="可选，例如 key=value" />

                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                              Content="加密启动参数" IsChecked="{Binding EncryptArgumentsV2}"
                              IsEnabled="{Binding CanEncryptLaunchArguments}" />

                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                              Content="游戏退出后关闭启动器" IsChecked="{Binding ExitLauncherWhenGameExit}" />
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Classes="hint"
                               IsVisible="{Binding !CanEncryptLaunchArguments}" Text="xlcore/xom 使用普通启动参数。" />
                </Grid>

                <TextBlock Text="卫月 (Dalamud)" Classes="section" />

                <StackPanel Spacing="8">
                    <CheckBox Content="启用卫月插件系统" IsChecked="{Binding DalamudEnabled}" />

                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="加载方式" Classes="label" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding LoadMethods}"
                                  SelectedItem="{Binding SelectedLoadMethod}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="注入延迟" Classes="label" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <NumericUpDown Value="{Binding DalamudDelayMs}" Minimum="0" Maximum="10000"
                                           Increment="100" Width="160" />
                            <TextBlock Text="毫秒" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="hint"
                               Text="EntryPoint 为推荐方式：由卫月注入器在 Wine 内启动游戏并注入。修改后需重新登录启动才会生效。" />
                </StackPanel>

                <TextBlock Text="Wine 环境" Classes="section" />

                <Border Padding="12" BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}">
                    <SelectableTextBlock Text="{Binding WineInfo}" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="提示：本启动器会复用 XIVLauncherCN.Core 的 Wine Prefix、游戏与卫月配置；若更换游戏目录，请确保其中包含 game/ffxiv_dx11.exe。"
                           Classes="hint" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
