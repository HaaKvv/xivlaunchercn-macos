<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XIVLauncher.Views.InputDialog"
        Title="{Binding DialogTitle}"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#181825" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="Foreground" Value="#CDD6F4" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#5865F2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Border Padding="18" Background="#181825">
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Prompt}" FontSize="13"
                       Foreground="#CDD6F4" TextWrapping="Wrap" />

            <!-- 验证码图片（可选） -->
            <Image Source="{Binding Image}" Width="140" Height="44"
                   Stretch="Uniform" IsVisible="{Binding HasImage}" />

            <TextBox x:Name="InputBox" Watermark="{Binding Watermark}" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="取消" Click="OnCancelClick" />
                <Button Classes="primary" Content="确定" Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
