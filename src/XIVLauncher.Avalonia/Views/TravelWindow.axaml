<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XIVLauncher.Views.TravelWindow" Title="跨大区旅行"
        Width="720" Height="540" MinWidth="620" MinHeight="470"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBackgroundBrush}">
    <Window.Styles>
        <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        <Style Selector="TextBlock.label"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    </Window.Styles>
    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="AccountLabel" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="RefreshServiceButton" Content="刷新旅行服务" Click="OnRefresh" />
        </Grid>
        <TabControl x:Name="TravelTabs" Grid.Row="1">
            <TabItem Header="发起旅行">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,4,0" Spacing="16">
                        <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                            <TextBlock Classes="label" Text="来源服务器" />
                            <ComboBox Grid.Column="1" x:Name="SourceBox" PlaceholderText="选择来源服务器"
                                      AutomationProperties.Name="来源服务器" SelectionChanged="OnSourceChanged" />
                            <TextBlock Grid.Row="1" Classes="label" Text="角色" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CharacterBox" PlaceholderText="选择角色">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Classes="label" Text="目的服务器" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TargetBox" PlaceholderText="选择目的服务器" />
                        </Grid>
                        <Button x:Name="SubmitButton" Content="提交旅行申请…" Click="OnTravel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="在途角色">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                        <Button Content="刷新订单" Click="OnRefreshOrders" />
                        <TextBlock Grid.Column="1" x:Name="PageLabel" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Button Grid.Column="2" x:Name="PreviousPageButton" Content="上一页" Click="OnPreviousPage" />
                        <Button Grid.Column="3" x:Name="NextPageButton" Content="下一页" Click="OnNextPage" />
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="OrderList" SelectionChanged="OnOrderChanged" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReturnButton" Content="申请返回原大区…" Click="OnReturn" />
                        <Button x:Name="ChooseDestinationButton" Content="选中目的大区" Click="OnUseOrderArea" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock x:Name="Notice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AcceptOrderButton" Content="确认传送" Click="OnConfirmOrder" IsVisible="False" />
                <Button x:Name="RejectOrderButton" Content="取消服务器订单" Click="OnRejectOrder" IsVisible="False" />
                <Button x:Name="CheckOrderButton" Content="继续查询处理状态" Click="OnCheckOrder" IsVisible="False" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PauseButton" Content="停止查询" Click="OnPause" IsVisible="False" />
            <Button x:Name="LaunchButton" Content="启动游戏" Click="OnLaunch" IsVisible="False" />
            <Button x:Name="CloseButton" Content="关闭" Click="OnClose" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
