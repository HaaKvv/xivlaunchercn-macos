<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XIVLauncher.Views.ConfirmDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBackgroundBrush}">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Click="OnCancel" />
            <Button x:Name="Accept" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
